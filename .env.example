# Local development only. Compose reads .env; Python reads environment variables.
POSTGRES_USER=claims
POSTGRES_PASSWORD=claims
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://claims:claims@localhost:5433/insurance_claims
TEST_DATABASE_URL=postgresql+psycopg://claims:claims@localhost:5433/insurance_claims_test
QDRANT_URL=http://localhost:6333
CLAIMS_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CLAIMS_SIMILAR_COLLECTION=insurance_claims_similar_v1
CLAIMS_INDEX_BATCH_SIZE=32
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_POLICY_COLLECTION=insurance_policy_chunks_v1
RAG_PROCEDURE_COLLECTION=insurance_procedure_chunks_v1
RAG_MAX_CHUNK_CHARS=600
RAG_INDEX_BATCH_SIZE=32
# RAG and advisory agent generation: choose an installed Ollama model.
# Agent reviews reuse this provider and the existing DB/vector settings above.
# No MLflow model is loaded: the agent only reads already stored assessments.
# CLAIMS_LLM_MODEL=<installed-model-name>
OLLAMA_HOST=http://localhost:11434
# Optional secrets supplied externally: QDRANT_API_KEY, HF_TOKEN
