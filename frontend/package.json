{
  "name": "claims-review-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "node tooling/run-next.mjs dev",
    "dev:demo": "node tooling/run-next.mjs dev --demo",
    "build": "node tooling/run-next.mjs build",
    "build:demo": "node tooling/run-next.mjs build --demo",
    "start": "node tooling/run-next.mjs start",
    "preview:demo": "node tooling/preview-demo.mjs",
    "prepare": "panda codegen",
    "pretest": "node tooling/prepare.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pandacss/dev": "^2.1.2",
    "@pandacss/preset-base": "^2.1.2",
    "@pandacss/preset-panda": "^2.1.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.29",
    "prettier": "^3.6.2",
    "typescript": "6.0",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
